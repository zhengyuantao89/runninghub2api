RH2API_ADDR=:8088
RH2API_ADMIN_USER=admin
RH2API_ADMIN_PASSWORD=admin123
# 下游调用 & 账号推送共用这一把（系统设置页可复制）
RH2API_API_KEY=change-me-api-key
RH2API_DATA_DIR=./data
RH2API_WEB_DIR=./web/dist
RH2API_BASE_URL=https://www.runninghub.ai
RH2API_WEBAPP_ID=2099427470494662657
RH2API_WORKERS=2
# 同一账号两次提交 RH 任务的最小间隔（秒）；失败后可继续派，只是缓几秒
RH2API_SUBMIT_GAP_SEC=3
# 本地 uploads 保留小时数：任务结束后超过此时长清理；孤儿文件同样按此保留
RH2API_UPLOAD_KEEP_HOURS=24
# 任务进度轮询：apikey（默认，官方 openapi）或 at（原 Access Token）
# 系统设置页可覆盖，即时生效
RH2API_POLL_AUTH=apikey
# 提交通道：webapp（默认 /task/webapp/create）或 qc_free（Runow QC 免费图生视频）
RH2API_SUBMIT_MODE=webapp
# 兼容旧变量（可选）：未设置 RH2API_API_KEY 时会回退读取
# RH2API_AUTH_KEY=
# RH2API_ADMIN_KEY=
# RH2API_SYNC_TOKEN=
